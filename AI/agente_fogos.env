# Copiar para ".env" (e não versionar) ou exportar diretamente no shell/systemd.

# --- Área a monitorizar ---
FIRE_DISTRICT=Coimbra
# FIRE_CONCELHO=Coimbra          # opcional: restringir só ao concelho (deixar vazio = todo o distrito)

# --- OpenRouter ---
OPENROUTER_API_KEY=coloca_aqui_a_tua_chave
OPENROUTER_MODEL=openai/gpt-4o-mini
# Ver modelos e preços atualizados em: https://openrouter.ai/models

# --- Notificação por email (opcional) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=o-teu-email@exemplo.pt
# SMTP_PASS=palavra-passe-de-aplicacao
# NOTIFY_EMAIL_TO=destino@exemplo.pt
# NOTIFY_EMAIL_FROM=o-teu-email@exemplo.pt

# --- Intervalo entre verificações em modo --loop (segundos) ---
POLL_INTERVAL_SECONDS=300

# --- Fonte de dados de incêndios ---
FOGOS_API_URL=https://api.fogos.pt/v2/incidents/active
FOGOS_API_KEY=coloca_aqui_a_tua_chave_oficial
FOGOS_API_KEY_HEADER=X-API-Key
FOGOS_API_KEY_PREFIX=
FOGOS_MAX_RETRIES=3
