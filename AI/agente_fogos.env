# Copiar para ".env" (e nC#o versionar) ou exportar diretamente no shell/systemd.

# --- Crea a monitorizar ---
FIRE_DISTRICT=Coimbra
FIRE_CONCELHO=Coimbra
# opcional: restringir sC3 ao concelho (deixar vazio = todo o distrito)

# --- OpenRouter ---
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxb
OPENROUTER_MODEL=openai/gpt-4o-mini
# Ver modelos e preC'os atualizados em: https://openrouter.ai/models

# --- NotificaC'C#o por email (opcional) ---
 SMTP_HOST=mail.xxxxxxxx.pt
 SMTP_PORT=587
 SMTP_USER=noreply-teste@xxxxx.pt
 SMTP_PASS=xxxxxxxx
 NOTIFY_EMAIL_TO=carlos.domingues@xxxxxxxx.pt
 NOTIFY_EMAIL_FROM=noreply3@xxxxxxx.pt

# --- Intervalo entre verificaC'C5es em modo --loop (segundos) ---
POLL_INTERVAL_SECONDS=300

# --- Fonte de dados de incC*ndios (avanC'ado) ---
FOGOS_API_URL=https://api-dev.fogos.pt/new/fires
FOGOS_API_KEY=ssss
